# ─────────────────────────────────────────────────────────────
# TrueReel – Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Ohne Supabase/Stripe-Keys läuft die App im DEMO-MODUS
# (lokale Anmeldung im Browser, simulierter Checkout).
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:5173
PORT=8787

# Supabase (Frontend – öffentlich)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Supabase (Server – GEHEIM, niemals ins Frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Wird von npm run setup:stripe gesetzt (Kundenportal mit 1-Klick-Kündigung)
STRIPE_PORTAL_CONFIG=
STRIPE_PRICE_HOBBY_MONTHLY=price_xxx
STRIPE_PRICE_HOBBY_YEARLY=price_xxx
STRIPE_PRICE_DAILY_MONTHLY=price_xxx
STRIPE_PRICE_DAILY_YEARLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx

# ── KI-Module (austauschbar) ─────────────────────────────────
# Skript (LLM): mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Bilder: mock (prozedurale Platzhalter-Grafiken im Browser) | pixabay (gratis Stock) | openai (KI-Bilder)
IMAGE_PROVIDER=mock
PIXABAY_API_KEY=
OPENAI_API_KEY=

# Voice (TTS): mock (Browser-Stimme nur für Vorschau) | elevenlabs | openai
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=

# Rendering: ffmpeg (Server wandelt Browser-Aufnahme in MP4/H.264 1080x1920 um)
RENDER_PROVIDER=ffmpeg
FFMPEG_PATH=ffmpeg

# ── Social-APIs (Auto-Posting) ───────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
