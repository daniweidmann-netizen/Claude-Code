# ─────────────────────────────────────────────────────────────
# VIRELI — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=de-CH

# ── Shopify Storefront API (from the "Headless" sales channel) ─
# Store domain, e.g. your-store.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=
# Pinned API version, reviewed quarterly
SHOPIFY_STOREFRONT_API_VERSION=2026-10
# PRIVATE token — server only. Used by Server Actions / RSC. Never expose.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# PUBLIC token — optional, only if client-side Storefront queries are needed
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Handle of the product (Shopify Admin → product → URL handle)
SHOPIFY_PRODUCT_HANDLE=

# ── Shopify webhooks (cache revalidation) ─────────────────────
# Shopify Admin → Settings → Notifications → Webhooks → signing secret
SHOPIFY_WEBHOOK_SECRET=

# ── Shopify analytics / consent (optional, Phase 8) ───────────
# Numeric shop ID, used by @shopify/hydrogen-react analytics
SHOPIFY_SHOP_ID=
# Customer Account API (optional, only if account login is offered)
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# ── Media CDN (videos & large assets) ─────────────────────────
# e.g. Vercel Blob public base URL or Mux/Cloudflare URL. Empty = serve from /public
NEXT_PUBLIC_MEDIA_BASE_URL=
# Only if uploading via Vercel Blob from scripts (server/CI only)
BLOB_READ_WRITE_TOKEN=

# ── Feature flags ─────────────────────────────────────────────
# Show "Asset pending" labels on placeholders (true in previews, false in production)
NEXT_PUBLIC_SHOW_PLACEHOLDER_LABELS=true
# Force a quality tier for testing: auto | 0 | 1 | 2 | 3
NEXT_PUBLIC_FORCE_QUALITY_TIER=auto
