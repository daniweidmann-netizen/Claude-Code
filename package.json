{
  "name": "truereel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TrueReel – faceless Kurzvideos, ehrlich, einfach, automatisch.",
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "setup:stripe": "node scripts/setup-stripe.js",
    "check": "node scripts/check-setup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.71.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6"
  }
}
