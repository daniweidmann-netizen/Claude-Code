{
  "name": "temple-of-the-lost-sun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "sim": "npm run build --silent && node dist/tools/sim/cli.js",
    "bonus-ev": "npm run build --silent && node dist/tools/sim/bonus-ev.js",
    "dev": "vite",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "preview": "vite preview",
    "e2e": "node tools/e2e/smoke.cjs",
    "e2e:quick": "SMOKE_QUICK=1 node tools/e2e/smoke.cjs",
    "e2e:final": "node tools/e2e/final.cjs",
    "e2e:resilience": "node tools/e2e/resilience.cjs",
    "build:single": "node tools/build-single.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.2",
    "phaser": "^3.90.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  }
}
